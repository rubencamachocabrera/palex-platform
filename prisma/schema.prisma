// Modelo de datos Palex Medical -- Fase 4: Pre-Proyectos + Hardware

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS -----------------------------------------------------------

enum Rol {
  ADMIN
  VENTAS
  PROYECTOS
  TECNICO
}

enum TipoHospital {
  HOSPITAL_PUBLICO
  HOSPITAL_PRIVADO
  CLINICA_PRIVADA
  LABORATORIO
  CENTRO_SALUD
  UNIVERSIDAD
  OTRO
}

enum TipoVisita {
  PROYECTOS
  VENTAS
}

enum EstadoVisita {
  BORRADOR
  COMPLETADA
  ARCHIVADA
}

enum EstadoModulo {
  PENDIENTE
  EN_INSTALACION
  INSTALADO
  FORMACION
  VALIDADO
}

enum EtapaPipeline {
  IDENTIFICADO
  PRIMERA_VISITA
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum EstadoProyecto {
  NUEVO
  EN_CURSO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum TipoFase {
  FIRMA_CONTRATO
  VISITA_TECNICA
  SOLICITUD_MATERIAL
  ENTREGA_MATERIAL
  CONFIGURACION
  INSTALACION
  PUESTA_EN_MARCHA
  FORMACION
  VALIDACION
  ENTREGA_PROYECTO
  SOPORTE_POST
}

enum EstadoFase {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  BLOQUEADO
}

enum EstadoHardware {
  DISPONIBLE
  ASIGNADO
  EN_MANTENIMIENTO
  RETIRADO
  BAJA
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  EN_PREPARACION
  ENVIADA
  ENTREGADA
  CANCELADA
}

enum TipoTag {
  VISITA
  PROYECTO
}

enum TipoEntrada {
  EVENTO
  COMENTARIO
  CITA
}

enum EstadoTarea {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

enum PrioridadTarea {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum TipoFavorito {
  HOSPITAL
  PROYECTO
}

enum TipoIncidencia {
  HARDWARE
  SOFTWARE
}

enum CategoriaIncidencia {
  BC_ROBO
  ZEBRA_MC
  ZEBRA_IMPRESORA
  READER_RFID
  GATEWAY_BT
  MINI_PC
  NEVERA
  PANTALLA
  TOTEM
  INLAB
  OTRO
}

enum PrioridadIncidencia {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoIncidencia {
  ABIERTA
  EN_PROGRESO
  PENDIENTE_CLIENTE
  PENDIENTE_PROVEEDOR
  RESUELTA
  CERRADA
}

enum TipoEventoIncidencia {
  NOTA
  LLAMADA_ENTRANTE
  LLAMADA_SALIENTE
  EMAIL_ENVIADO
  EMAIL_RECIBIDO
  CAMBIO_ESTADO
  CAMBIO_ASIGNACION
  ESCALADO
  RESPUESTA_TECNICA
  RESPUESTA_APLICACIONES
  COMUNICACION_CLIENTE
  SOPORTE_REMOTO
  REUNION_INTERNA
  REUNION_CLIENTE
}

// --- CONFIG ----------------------------------------------------------

model ConfigApp {
  id                 Int     @id @default(1)
  crmActivo          Boolean @default(true)
  incidenciasActivo  Boolean @default(true) @map("incidencias_activo")
  analiticaActivo    Boolean @default(true) @map("analitica_activo")
  scoringConfig      Json?

  @@map("config_app")
}

// --- USUARIOS --------------------------------------------------------

model Usuario {
  id                    String   @id @default(cuid())
  nombre                String
  email                 String   @unique
  password              String
  rol                   Rol      @default(VENTAS)
  activo                Boolean  @default(true)
  onboardingCompletado  Boolean  @default(false)
  creadoEn              DateTime @default(now())
  editadoEn             DateTime @updatedAt

  zonas             UsuarioZona[]
  visitas           Visita[]
  oportunidades     Oportunidad[]
  proyectos         Proyecto[]       @relation("ProyectoResponsable")
  fasesResponsable  FaseProyecto[]   @relation("FaseResponsable")
  logs              LogActividad[]
  recordatorios             Recordatorio[]
  recordatoriosAsignados    Recordatorio[]  @relation("RecordatoriosAsignados")
  favoritos         Favorito[]
  filtrosGuardados  FiltroGuardado[]
  llamadas          RegistroLlamada[]
  tareasAsignadas       Tarea[]          @relation("TareasAsignadas")
  incidenciasReportadas Incidencia[]        @relation("IncidenciasReportadas")
  incidenciasAsignadas  Incidencia[]        @relation("IncidenciasAsignadas")
  eventosIncidencia     EventoIncidencia[]  @relation("EventosIncidencia")
  notasEquipo           NotaEquipo[]        @relation("NotasEquipo")
  checkins              CheckinHospital[]   @relation("CheckinsUsuario")
  relacionesCreadas     IncidenciaRelacion[] @relation("RelacionesCreadasPor")
  // Inteligencia InLab
  inlabCargas           InlabCarga[]         @relation("InlabCargasUsuario")
  inlabShares           InlabShare[]         @relation("InlabSharesUsuario")

  @@map("usuarios")
}

// --- ZONAS -----------------------------------------------------------

model Zona {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  hospitales Hospital[]
  usuarios   UsuarioZona[]

  @@map("zonas")
}

model UsuarioZona {
  usuarioId String
  zonaId    String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  zona    Zona    @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, zonaId])
  @@map("usuarios_zonas")
}

// --- HOSPITALES ------------------------------------------------------

model Hospital {
  id        String       @id @default(cuid())
  nombre    String
  ciudad    String
  provincia String?
  pais      String       @default("España")
  tipo      TipoHospital @default(HOSPITAL_PUBLICO)
  camas     Int?
  direccion String?
  activo    Boolean      @default(true)
  zonaId    String
  latitud   Float?
  longitud  Float?
  grupoId   String?
  creadoEn  DateTime     @default(now())
  editadoEn DateTime     @updatedAt

  zona             Zona             @relation(fields: [zonaId], references: [id])
  grupo            Hospital?        @relation("GrupoHospitalario", fields: [grupoId], references: [id], onDelete: SetNull)
  centros          Hospital[]       @relation("GrupoHospitalario")
  contactos        Contacto[]
  visitas          Visita[]
  oportunidades    Oportunidad[]
  proyectos     Proyecto[]
  hardwareUnidades HardwareUnidad[]
  llamadas         RegistroLlamada[]
  incidencias      Incidencia[]
  checkins         CheckinHospital[] @relation("CheckinsHospital")
  // Inteligencia InLab (agregados de exportaciones InLab)
  inlabCargas      InlabCarga[]
  inlabMapeo       InlabMapeo?
  inlabTarifas     InlabTarifa[]
  inlabShares      InlabShare[]

  @@index([zonaId])
  @@map("hospitales")
}

model Contacto {
  id         String   @id @default(cuid())
  hospitalId String
  nombre     String
  cargo      String?
  email      String?
  telefono   String?
  principal  Boolean  @default(false)
  creadoEn   DateTime @default(now())

  hospital         Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  proyectos     ProyectoContacto[]
  visitasPrincipal Visita[]              @relation("VisitaContactoPrincipal")
  llamadas         RegistroLlamada[]
  incidencias      Incidencia[]

  @@index([hospitalId])
  @@map("contactos")
}

// --- VISITAS ---------------------------------------------------------

model Visita {
  id                   String       @id @default(cuid())
  titulo               String?
  hospitalId           String
  usuarioId            String
  oportunidadId        String?
  proyectoId        String?  @map("preProyectoId")
  contactoPrincipalId  String?
  tipo                 TipoVisita
  estado               EstadoVisita @default(BORRADOR)
  fecha                DateTime     @default(now())
  datos                Json         @default("{}")
  fotos                Json         @default("[]")
  score                Int?
  creadoEn             DateTime     @default(now())
  editadoEn            DateTime     @updatedAt

  hospital           Hospital     @relation(fields: [hospitalId], references: [id])
  usuario            Usuario      @relation(fields: [usuarioId], references: [id])
  oportunidad        Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: SetNull)
  proyecto        Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  contactoPrincipal  Contacto?    @relation("VisitaContactoPrincipal", fields: [contactoPrincipalId], references: [id], onDelete: SetNull)
  comentarios        Comentario[]
  tags               VisitaTag[]

  @@index([hospitalId])
  @@index([usuarioId])
  @@index([fecha])
  @@map("visitas")
}

// --- MODULOS INLAB ---------------------------------------------------

model ProyectoModulo {
  proyectoId String @map("preProyectoId")
  moduloId      String
  estado        EstadoModulo @default(PENDIENTE)

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  modulo      ModuloInlab @relation("ProyectoModulos", fields: [moduloId], references: [id])

  @@id([proyectoId, moduloId])
  @@map("pre_proyectos_modulos")
}

model ModuloInlab {
  id                 String              @id @default(cuid())
  nombre             String              @unique
  activo             Boolean             @default(true)
  proyectoModulos ProyectoModulo[] @relation("ProyectoModulos")

  @@map("modulos_inlab")
}

// --- CRM / PIPELINE --------------------------------------------------

model Oportunidad {
  id            String        @id @default(cuid())
  hospitalId    String
  usuarioId     String
  titulo        String
  etapa         EtapaPipeline @default(IDENTIFICADO)
  valorEstimado Float?
  probabilidad  Int?
  fechaCierre   DateTime?
  productos     Json          @default("[]")
  notas         String?
  motivoPerdida String?
  historial     Json          @default("[]")
  creadoEn      DateTime      @default(now())
  editadoEn     DateTime      @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  visitas  Visita[]

  @@map("oportunidades")
}

// --- PROYECTOS -------------------------------------------------------

model Proyecto {
  id            String            @id @default(cuid())
  titulo        String
  descripcion   String?           @db.Text
  hospitalId    String
  responsableId String?
  estado        EstadoProyecto @default(NUEVO)
  prioridad     Int               @default(0)
  presupuesto   Float?
  fechaInicio   DateTime?
  fechaFinPlan  DateTime?
  fechaFinReal  DateTime?
  notas         String?           @db.Text
  refContrato   String?
  refConcurso   String?
  mapaHtml      String?           @db.Text
  shareToken    String?           @unique
  creadoEn      DateTime          @default(now())
  editadoEn     DateTime          @updatedAt

  hospital         Hospital              @relation(fields: [hospitalId], references: [id])
  responsable      Usuario?              @relation("ProyectoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  fases            FaseProyecto[]
  hitos            Hito[]
  solicitudes      SolicitudMaterial[]
  hardwareUnidades HardwareUnidad[]
  contactos        ProyectoContacto[]
  visitas          Visita[]
  entradas         EntradaTimeline[]
  tareas           Tarea[]
  adjuntos         Adjunto[]
  comentarios      Comentario[]
  modulos          ProyectoModulo[]
  tags             ProyectoTag[]

  @@index([hospitalId])
  @@index([responsableId])
  @@map("pre_proyectos")
}

model FaseProyecto {
  id            String     @id @default(cuid())
  proyectoId String @map("preProyectoId")
  tipo          TipoFase
  nombre        String
  orden         Int
  estado        EstadoFase @default(PENDIENTE)
  fechaPlan     DateTime?
  fechaReal     DateTime?
  responsableId String?
  notas         String?    @db.Text
  creadoEn      DateTime   @default(now())
  editadoEn     DateTime   @updatedAt

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  responsable Usuario?    @relation("FaseResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@map("fases_pre_proyectos")
}

model Hito {
  id            String   @id @default(cuid())
  proyectoId String @map("preProyectoId")
  titulo        String
  descripcion   String?
  fecha         DateTime
  fechaReal     DateTime?
  completado    Boolean  @default(false)
  creadoEn      DateTime @default(now())
  editadoEn     DateTime @updatedAt

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@map("hitos")
}

model EntradaTimeline {
  id            String      @id @default(cuid())
  proyectoId String @map("preProyectoId")
  tipo          TipoEntrada
  titulo        String
  contenido     String?     @db.Text
  fechaEntrada  DateTime    @default(now())
  fechaCita       DateTime?
  personaCita     String?
  lugarCita       String?
  motivoCita      String?
  importanciaCita Int?
  autor           String    @default("")
  creadoEn      DateTime    @default(now())
  editadoEn     DateTime    @updatedAt

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@map("entradas_timeline")
}

model Tarea {
  id               String         @id @default(cuid())
  proyectoId    String @map("preProyectoId")
  parentId         String?
  titulo           String
  descripcion      String?        @db.Text
  estado           EstadoTarea    @default(PENDIENTE)
  prioridad        PrioridadTarea @default(MEDIA)
  asignadoA        String?
  asignadoAId      String?        @map("asignado_a_id")
  fechaVencimiento DateTime?
  fechaCompletada  DateTime?
  orden            Int            @default(0)
  creadoEn         DateTime       @default(now())
  editadoEn        DateTime       @updatedAt

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  parent      Tarea?      @relation("TareaSubtareas", fields: [parentId], references: [id], onDelete: Cascade)
  subtareas   Tarea[]     @relation("TareaSubtareas")
  asignado    Usuario?    @relation("TareasAsignadas", fields: [asignadoAId], references: [id], onDelete: SetNull)

  @@index([proyectoId])
  @@index([asignadoAId])
  @@map("tareas")
}

model SolicitudMaterial {
  id               String          @id @default(cuid())
  proyectoId    String @map("preProyectoId")
  titulo           String
  estado           EstadoSolicitud @default(PENDIENTE)
  fechaSolicitud   DateTime        @default(now())
  fechaEntregaPlan DateTime?
  fechaEntregaReal DateTime?
  notas            String?         @db.Text
  creadoEn         DateTime        @default(now())
  editadoEn        DateTime        @updatedAt

  proyecto Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  lineas      LineaMaterial[]

  @@index([proyectoId])
  @@map("solicitudes_material")
}

model LineaMaterial {
  id                String @id @default(cuid())
  solicitudId       String
  nombre            String
  referencia        String?
  cantidad          Int
  cantidadEntregada Int    @default(0)
  unidad            String @default("ud")
  notas             String?

  solicitud SolicitudMaterial @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@map("lineas_material")
}

// --- HARDWARE --------------------------------------------------------

model HardwareTipo {
  id       String   @id @default(cuid())
  nombre   String   @unique
  color    String   @default("#6b7280")
  orden    Int      @default(0)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now())

  catalogos HardwareCatalogo[]

  @@map("hardware_tipos")
}

model HardwareCatalogo {
  id              String        @id @default(cuid())
  tipoId          String?       @map("tipo_id")
  tipo            HardwareTipo? @relation(fields: [tipoId], references: [id])
  marca           String
  modelo          String
  referenciaPalex String?
  proveedor       String?
  descripcion     String?
  precio          Float?
  garantiaMeses   Int?
  fichaUrl        String?
  activo          Boolean       @default(true)
  creadoEn        DateTime      @default(now())
  editadoEn       DateTime      @updatedAt

  unidades HardwareUnidad[]
  docs     HardwareCatalogoDoc[]

  @@map("hardware_catalogo")
}

model HardwareCatalogoDoc {
  id         String           @id @default(cuid())
  catalogoId String
  nombre     String
  tipo       String
  tamano     Int
  contenido  String           @db.Text
  creadoEn   DateTime         @default(now())

  catalogo HardwareCatalogo @relation(fields: [catalogoId], references: [id], onDelete: Cascade)

  @@map("hardware_catalogo_docs")
}

model HardwareUnidad {
  id            String         @id @default(cuid())
  catalogoId    String
  numSerie      String?
  estado        EstadoHardware @default(DISPONIBLE)
  hospitalId    String?
  proyectoId String?  @map("preProyectoId")
  fechaCompra           DateTime?
  fechaGarantia         DateTime?
  proximoMantenimiento  DateTime?
  notas                 String?
  creadoEn              DateTime       @default(now())
  editadoEn     DateTime       @updatedAt

  catalogo    HardwareCatalogo @relation(fields: [catalogoId], references: [id])
  hospital    Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  proyecto Proyecto?     @relation(fields: [proyectoId], references: [id], onDelete: SetNull)
  incidencias Incidencia[]

  @@index([hospitalId])
  @@index([catalogoId])
  @@map("hardware_unidades")
}

// --- PIVOT PROYECTOS <-> CONTACTOS -----------------------------------

model ProyectoContacto {
  proyectoId String @map("preProyectoId")
  contactoId    String

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  contacto    Contacto    @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@id([proyectoId, contactoId])
  @@map("pre_proyectos_contactos")
}

// --- ADJUNTOS --------------------------------------------------------

model Adjunto {
  id            String   @id @default(cuid())
  proyectoId String @map("preProyectoId")
  nombre        String
  tipo          String
  tamano        Int
  contenido     String   @db.Text
  creadoPor     String   @default("")
  creadoEn      DateTime @default(now())

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@map("adjuntos")
}

// --- PLANTILLAS DE VISITA --------------------------------------------

// --- COMENTARIOS ----------------------------------------------------------

model Comentario {
  id            String   @id @default(cuid())
  visitaId      String?
  proyectoId String?  @map("preProyectoId")
  autorId       String
  autorNombre   String
  contenido     String   @db.Text
  fotos         Json     @default("[]")
  mencionIds    Json     @default("[]")
  creadoEn      DateTime @default(now())
  editadoEn     DateTime @updatedAt

  visita      Visita?      @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  proyecto Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([visitaId])
  @@index([proyectoId])
  @@map("comentarios")
}

model PlantillaVisita {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  tipo        String   @default("PROYECTOS") // PROYECTOS | VENTAS
  datos       Json     @default("{}")
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  editadoEn   DateTime @updatedAt

  @@map("plantillas_visita")
}

// --- TAGS / ETIQUETAS ------------------------------------------------

model Tag {
  id       String  @id @default(cuid())
  nombre   String
  color    String  @default("#00A99D")
  tipo     TipoTag
  orden    Int     @default(0)
  activo   Boolean @default(true)
  creadoEn DateTime @default(now())

  visitas   VisitaTag[]
  proyectos ProyectoTag[]

  @@unique([nombre, tipo])
  @@map("tags")
}

model VisitaTag {
  visitaId String
  tagId    String

  visita Visita @relation(fields: [visitaId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([visitaId, tagId])
  @@map("visitas_tags")
}

model ProyectoTag {
  proyectoId String @map("preProyectoId")
  tagId      String

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([proyectoId, tagId])
  @@map("proyectos_tags")
}

// --- LOG ACTIVIDAD ---------------------------------------------------

model LogActividad {
  id        String   @id @default(cuid())
  accion    String
  entidad   String
  entidadId String?  @map("entidad_id")
  detalle   String?
  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([creadoEn])
  @@index([usuarioId])
  @@map("log_actividad")
}

// --- NOTAS EQUIPO ----------------------------------------------------

model NotaEquipo {
  id         String   @id @default(cuid())
  texto      String   @db.Text
  autorId    String   @map("autor_id")
  mencionIds Json     @default("[]")
  fijada     Boolean  @default(false)
  creadoEn   DateTime @default(now()) @map("creado_en")
  editadoEn  DateTime @updatedAt @map("editado_en")

  autor Usuario @relation("NotasEquipo", fields: [autorId], references: [id])

  @@index([creadoEn])
  @@map("notas_equipo")
}

// --- CHECK-IN / CHECK-OUT HOSPITALES ---------------------------------

model CheckinHospital {
  id         String    @id @default(cuid())
  usuarioId  String    @map("usuario_id")
  hospitalId String    @map("hospital_id")
  entradaEn  DateTime  @default(now()) @map("entrada_en")
  salidaEn   DateTime? @map("salida_en")
  duracion   Int?      // minutos totales en campo
  notas      String?   @db.Text
  creadoEn   DateTime  @default(now()) @map("creado_en")

  usuario  Usuario  @relation("CheckinsUsuario",  fields: [usuarioId],  references: [id])
  hospital Hospital @relation("CheckinsHospital", fields: [hospitalId], references: [id])

  @@index([hospitalId])
  @@index([usuarioId])
  @@index([entradaEn])
  @@map("checkins_hospital")
}

// --- RECORDATORIOS ---------------------------------------------------

model Recordatorio {
  id            String    @id @default(cuid())
  titulo        String
  descripcion   String?
  fecha         DateTime
  completado    Boolean   @default(false)
  usuarioId     String    @map("usuario_id")
  asignadoAId   String?   @map("asignado_a_id")
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  asignadoA     Usuario?  @relation("RecordatoriosAsignados", fields: [asignadoAId], references: [id], onDelete: SetNull)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  editadoEn     DateTime  @updatedAt @map("editado_en")

  @@index([usuarioId, fecha])
  @@index([asignadoAId])
  @@index([fecha])
  @@map("recordatorios")
}

// --- FAVORITOS -----------------------------------------------------------

model Favorito {
  id        String       @id @default(cuid())
  usuarioId String       @map("usuario_id")
  entidadId String       @map("entidad_id")
  tipo      TipoFavorito
  creadoEn  DateTime     @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, entidadId, tipo])
  @@index([usuarioId])
  @@map("favoritos")
}

model FiltroGuardado {
  id        String   @id @default(cuid())
  usuarioId String   @map("usuario_id")
  entidad   String
  nombre    String
  filtros   Json
  creadoEn  DateTime @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, entidad, nombre])
  @@index([usuarioId, entidad])
  @@map("filtros_guardados")
}

// --- REGISTRO DE LLAMADAS ------------------------------------------------

model RegistroLlamada {
  id               String    @id @default(cuid())
  hospitalId       String    @map("hospital_id")
  contactoId       String?   @map("contacto_id")
  usuarioId        String    @map("usuario_id")
  fecha            DateTime  @default(now())
  duracion         Int?
  asunto           String
  notas            String?   @db.Text
  resultado        String?
  seguimiento      Boolean   @default(false)
  fechaSeguimiento DateTime? @map("fecha_seguimiento")
  creadoEn         DateTime  @default(now()) @map("creado_en")
  editadoEn        DateTime  @updatedAt @map("editado_en")

  hospital  Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  contacto  Contacto? @relation(fields: [contactoId], references: [id], onDelete: SetNull)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, fecha])
  @@index([hospitalId])
  @@map("registros_llamadas")
}

// --- INCIDENCIAS / HELPDESK ------------------------------------------

model Incidencia {
  id                  String               @id @default(cuid())
  codigo              String               @unique
  titulo              String
  descripcion         String               @db.Text
  tipo                TipoIncidencia
  categoria           CategoriaIncidencia
  prioridad           PrioridadIncidencia  @default(MEDIA)
  estado              EstadoIncidencia     @default(ABIERTA)
  equipoResponsable   String               @default("SERVICIO_TECNICO") @map("equipo_responsable")
  slaHoras            Int?                 @default(48) @map("sla_horas")
  resolucion          String?              @db.Text

  hospitalId          String               @map("hospital_id")
  contactoId          String?              @map("contacto_id")
  hardwareUnidadId    String?              @map("hardware_unidad_id")
  reportadoPorId      String               @map("reportado_por_id")
  asignadoAId         String?              @map("asignado_a_id")

  hospital            Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  contacto            Contacto?            @relation(fields: [contactoId], references: [id], onDelete: SetNull)
  hardwareUnidad      HardwareUnidad?      @relation(fields: [hardwareUnidadId], references: [id], onDelete: SetNull)
  reportadoPor        Usuario              @relation("IncidenciasReportadas", fields: [reportadoPorId], references: [id])
  asignadoA           Usuario?             @relation("IncidenciasAsignadas", fields: [asignadoAId], references: [id], onDelete: SetNull)

  eventos             EventoIncidencia[]
  relacionesOrigen    IncidenciaRelacion[] @relation("RelacionesOrigen")
  relacionesDestino   IncidenciaRelacion[] @relation("RelacionesDestino")

  coasignadosIds      Json?                @default("[]") @map("coasignados_ids")
  slaPausadoEn        DateTime?            @map("sla_pausado_en")
  slaPausadoMs        Int                  @default(0) @map("sla_pausado_ms")

  creadoEn            DateTime             @default(now()) @map("creado_en")
  actualizadoEn       DateTime             @updatedAt @map("actualizado_en")
  fechaResolucion     DateTime?            @map("fecha_resolucion")
  fechaCierre         DateTime?            @map("fecha_cierre")

  @@index([hospitalId])
  @@index([estado])
  @@index([asignadoAId])
  @@index([reportadoPorId])
  @@index([creadoEn])
  @@map("incidencias")
}

model EventoIncidencia {
  id                  String                @id @default(cuid())
  tipo                TipoEventoIncidencia
  descripcion         String                @db.Text
  duracion            Int?
  privado             Boolean               @default(false)
  metadatos           Json?

  incidenciaId        String                @map("incidencia_id")
  autorId             String                @map("autor_id")

  incidencia          Incidencia            @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
  autor               Usuario               @relation("EventosIncidencia", fields: [autorId], references: [id])

  fotos               Json?
  realizadoPorNombres Json?                 @map("realizado_por_nombres")
  editadoPor          String?               @map("editado_por")
  editadoEn           DateTime?             @map("editado_en")

  creadoEn            DateTime              @default(now()) @map("creado_en")

  @@index([incidenciaId])
  @@map("eventos_incidencia")
}

model RespuestaRapidaIncidencia {
  id        String  @id @default(cuid())
  texto     String  @db.Text
  categoria String?
  orden     Int     @default(0)
  activo    Boolean @default(true)

  @@map("respuestas_rapidas_incidencia")
}

enum TipoRelacionIncidencia {
  DUPLICADA
  RELACIONADA
  CAUSA_RAIZ
}

model IncidenciaRelacion {
  id            String                 @id @default(cuid())
  tipo          TipoRelacionIncidencia
  incidenciaId  String                 @map("incidencia_id")
  relacionadaId String                 @map("relacionada_id")
  creadoPorId   String                 @map("creado_por_id")
  creadoEn      DateTime               @default(now()) @map("creado_en")

  incidencia    Incidencia             @relation("RelacionesOrigen", fields: [incidenciaId], references: [id], onDelete: Cascade)
  relacionada   Incidencia             @relation("RelacionesDestino", fields: [relacionadaId], references: [id], onDelete: Cascade)
  creadoPor     Usuario                @relation("RelacionesCreadasPor", fields: [creadoPorId], references: [id])

  @@unique([incidenciaId, relacionadaId])
  @@index([incidenciaId])
  @@index([relacionadaId])
  @@map("incidencias_relaciones")
}

// --- INTELIGENCIA INLAB ----------------------------------------------
// Solo se guardan AGREGADOS calculados en el navegador a partir de la
// exportación CSV de InLab (nunca filas crudas: pueden contener datos de
// pacientes). Cada carga acumula histórico; los agregados diarios cuelgan
// de la carga (onDelete Cascade) y repiten hospitalId (sin FK) para poder
// consultar por hospital + rango de fechas con un único índice.
// Ver src/lib/inlab/README.md.

model InlabCarga {
  id               String   @id @default(cuid())
  hospitalId       String   @map("hospital_id")
  usuarioId        String   @map("usuario_id")
  fichero          String
  tamanoBytes      Float    @default(0) @map("tamano_bytes")
  hash             String
  desde            DateTime @db.Date
  hasta            DateTime @db.Date
  filas            Int      @default(0)
  filasValidas     Int      @default(0) @map("filas_validas")
  filasDescartadas Int      @default(0) @map("filas_descartadas")
  dias             Int      @default(0)
  diasSustituidos  Int      @default(0) @map("dias_sustituidos")
  diasOmitidos     Int      @default(0) @map("dias_omitidos")
  modo             String   @default("NUEVA") // NUEVA | SUSTITUIR | OMITIR
  estado           String   @default("COMPLETADA")
  mapeo            Json?
  opciones         Json?
  avisos           Json?
  creadoEn         DateTime @default(now()) @map("creado_en")

  hospital  Hospital               @relation(fields: [hospitalId], references: [id])
  usuario   Usuario                @relation("InlabCargasUsuario", fields: [usuarioId], references: [id])
  consumo   InlabConsumoDiario[]
  puestos   InlabPuestoDiario[]
  actividad InlabActividadDiaria[]
  tiempos   InlabTiempoDiario[]
  eventos   InlabEventoDiario[]

  @@index([hospitalId, creadoEn])
  @@index([hospitalId, hash])
  @@map("inlab_cargas")
}

// Consumo por día × área × consumible × urgencia
model InlabConsumoDiario {
  id         Int      @id @default(autoincrement())
  cargaId    String   @map("carga_id")
  hospitalId String   @map("hospital_id")
  fecha      DateTime @db.Date
  area       String   @default("")
  consumible String   @default("")
  urgente    Boolean  @default(false)
  unidades   Int      @default(0)
  registros  Int      @default(0)

  carga InlabCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)

  @@index([hospitalId, fecha])
  @@index([cargaId])
  @@map("inlab_consumo_diario")
}

// Actividad por día × área × puesto
model InlabPuestoDiario {
  id         Int      @id @default(autoincrement())
  cargaId    String   @map("carga_id")
  hospitalId String   @map("hospital_id")
  fecha      DateTime @db.Date
  area       String   @default("")
  puesto     String   @default("")
  registros  Int      @default(0)
  unidades   Int      @default(0)
  urgentes   Int      @default(0)
  eventos    Int      @default(0)

  carga InlabCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)

  @@index([hospitalId, fecha])
  @@index([cargaId])
  @@map("inlab_puesto_diario")
}

// Actividad por día × área: totales, órdenes distintas y reparto por hora (24 valores)
model InlabActividadDiaria {
  id         Int      @id @default(autoincrement())
  cargaId    String   @map("carga_id")
  hospitalId String   @map("hospital_id")
  fecha      DateTime @db.Date
  area       String   @default("")
  registros  Int      @default(0)
  unidades   Int      @default(0)
  urgentes   Int      @default(0)
  ordenes    Int?
  porHora    Int[]    @default([]) @map("por_hora")

  carga InlabCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)

  @@index([hospitalId, fecha])
  @@index([cargaId])
  @@map("inlab_actividad_diaria")
}

// Tiempos entre hitos por día × área × urgencia × tramo, con histograma de
// buckets fijos (src/lib/inlab/histogram.ts) para calcular percentiles
// sobre cualquier rango sumando histogramas.
model InlabTiempoDiario {
  id         Int      @id @default(autoincrement())
  cargaId    String   @map("carga_id")
  hospitalId String   @map("hospital_id")
  fecha      DateTime @db.Date
  area       String   @default("")
  urgente    Boolean  @default(false)
  tramo      String   @default("")
  n          Int      @default(0)
  sumaMin    Float    @default(0) @map("suma_min")
  maxMin     Float    @default(0) @map("max_min")
  histograma Int[]    @default([])

  carga InlabCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)

  @@index([hospitalId, fecha])
  @@index([cargaId])
  @@map("inlab_tiempo_diario")
}

// Eventos/incidencias del propio fichero InLab (reimpresiones, rechazos...)
model InlabEventoDiario {
  id         Int      @id @default(autoincrement())
  cargaId    String   @map("carga_id")
  hospitalId String   @map("hospital_id")
  fecha      DateTime @db.Date
  area       String   @default("")
  puesto     String   @default("")
  impresora  String   @default("")
  tipo       String   @default("OTRO")
  detalle    String   @default("")
  cantidad   Int      @default(0)

  carga InlabCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)

  @@index([hospitalId, fecha])
  @@index([cargaId])
  @@map("inlab_evento_diario")
}

// Emparejamiento de columnas guardado por hospital (cabecera CSV → campo canónico)
model InlabMapeo {
  id         String   @id @default(cuid())
  hospitalId String   @unique @map("hospital_id")
  mapeo      Json
  opciones   Json?
  usuarioId  String?  @map("usuario_id")
  creadoEn   DateTime @default(now()) @map("creado_en")
  editadoEn  DateTime @updatedAt @map("editado_en")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@map("inlab_mapeos")
}

// Tarifas de facturación por hospital y consumible ("*" = resto de consumibles)
model InlabTarifa {
  id           String    @id @default(cuid())
  hospitalId   String    @map("hospital_id")
  consumible   String
  precio       Decimal   @default(0) @db.Decimal(12, 4)
  moneda       String    @default("EUR")
  unidad       String?
  vigenteDesde DateTime? @map("vigente_desde") @db.Date
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date
  creadoEn     DateTime  @default(now()) @map("creado_en")
  editadoEn    DateTime  @updatedAt @map("editado_en")

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@map("inlab_tarifas")
}

// Enlace público de solo lectura (/share/inlab/[token]) por hospital y periodo
model InlabShare {
  id                 String    @id @default(cuid())
  token              String    @unique
  hospitalId         String    @map("hospital_id")
  creadoPorId        String    @map("creado_por_id")
  desde              DateTime? @db.Date
  hasta              DateTime? @db.Date
  incluirFacturacion Boolean   @default(false) @map("incluir_facturacion")
  expiraEn           DateTime? @map("expira_en")
  revocado           Boolean   @default(false)
  vistas             Int       @default(0)
  ultimaVista        DateTime? @map("ultima_vista")
  creadoEn           DateTime  @default(now()) @map("creado_en")

  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  creadoPor Usuario  @relation("InlabSharesUsuario", fields: [creadoPorId], references: [id])

  @@index([hospitalId])
  @@map("inlab_shares")
}
