// Modelo de datos Palex Medical -- Fase 4: Pre-Proyectos + Hardware

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS -----------------------------------------------------------

enum Rol {
  ADMIN
  VENTAS
  PROYECTOS
  TECNICO
}

enum TipoHospital {
  HOSPITAL_PUBLICO
  HOSPITAL_PRIVADO
  CLINICA_PRIVADA
  LABORATORIO
  CENTRO_SALUD
  UNIVERSIDAD
  OTRO
}

enum TipoVisita {
  PROYECTOS
  VENTAS
}

enum EstadoVisita {
  BORRADOR
  COMPLETADA
  ARCHIVADA
}

enum EstadoModulo {
  PENDIENTE
  EN_INSTALACION
  INSTALADO
  FORMACION
  VALIDADO
}

enum EtapaPipeline {
  IDENTIFICADO
  PRIMERA_VISITA
  PROPUESTA
  NEGOCIACION
  GANADO
  PERDIDO
}

enum EstadoPreProyecto {
  NUEVO
  EN_CURSO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum TipoFase {
  FIRMA_CONTRATO
  VISITA_TECNICA
  SOLICITUD_MATERIAL
  ENTREGA_MATERIAL
  CONFIGURACION
  INSTALACION
  PUESTA_EN_MARCHA
  FORMACION
  VALIDACION
  ENTREGA_PROYECTO
  SOPORTE_POST
}

enum EstadoFase {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
  BLOQUEADO
}

enum TipoHardware {
  BC_ROBOT
  ZEBRA_MC
  ZEBRA_PRINTER
  LECTOR_BARRAS
  SERVIDOR
  SWITCH_RED
  TABLET
  OTRO
}

enum EstadoHardware {
  DISPONIBLE
  ASIGNADO
  EN_MANTENIMIENTO
  RETIRADO
  BAJA
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  EN_PREPARACION
  ENVIADA
  ENTREGADA
  CANCELADA
}

// --- CONFIG ----------------------------------------------------------

model ConfigApp {
  id        Int     @id @default(1)
  crmActivo Boolean @default(true)

  @@map("config_app")
}

// --- USUARIOS --------------------------------------------------------

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(VENTAS)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  editadoEn DateTime @updatedAt

  zonas             UsuarioZona[]
  visitas           Visita[]
  oportunidades     Oportunidad[]
  preProyectos      PreProyecto[]      @relation("PreProyectoResponsable")
  fasesResponsable  FasePreProyecto[]  @relation("FaseResponsable")

  @@map("usuarios")
}

// --- ZONAS -----------------------------------------------------------

model Zona {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  hospitales Hospital[]
  usuarios   UsuarioZona[]

  @@map("zonas")
}

model UsuarioZona {
  usuarioId String
  zonaId    String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  zona    Zona    @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, zonaId])
  @@map("usuarios_zonas")
}

// --- HOSPITALES ------------------------------------------------------

model Hospital {
  id        String       @id @default(cuid())
  nombre    String
  ciudad    String
  provincia String?
  pais      String       @default("España")
  tipo      TipoHospital @default(HOSPITAL_PUBLICO)
  camas     Int?
  direccion String?
  activo    Boolean      @default(true)
  zonaId    String
  latitud   Float?
  longitud  Float?
  creadoEn  DateTime     @default(now())
  editadoEn DateTime     @updatedAt

  zona             Zona             @relation(fields: [zonaId], references: [id])
  contactos        Contacto[]
  visitas          Visita[]
  oportunidades    Oportunidad[]
  proyectos        Proyecto[]
  preProyectos     PreProyecto[]
  hardwareUnidades HardwareUnidad[]

  @@map("hospitales")
}

model Contacto {
  id         String   @id @default(cuid())
  hospitalId String
  nombre     String
  cargo      String?
  email      String?
  telefono   String?
  principal  Boolean  @default(false)
  creadoEn   DateTime @default(now())

  hospital         Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  preProyectos     PreProyectoContacto[]
  visitasPrincipal Visita[]              @relation("VisitaContactoPrincipal")

  @@map("contactos")
}

// --- VISITAS ---------------------------------------------------------

model Visita {
  id                   String       @id @default(cuid())
  hospitalId           String
  usuarioId            String
  oportunidadId        String?
  preProyectoId        String?
  contactoPrincipalId  String?
  tipo                 TipoVisita
  estado               EstadoVisita @default(BORRADOR)
  fecha                DateTime     @default(now())
  datos                Json         @default("{}")
  fotos                Json         @default("[]")
  creadoEn             DateTime     @default(now())
  editadoEn            DateTime     @updatedAt

  hospital           Hospital     @relation(fields: [hospitalId], references: [id])
  usuario            Usuario      @relation(fields: [usuarioId], references: [id])
  oportunidad        Oportunidad? @relation(fields: [oportunidadId], references: [id], onDelete: SetNull)
  preProyecto        PreProyecto? @relation(fields: [preProyectoId], references: [id], onDelete: SetNull)
  contactoPrincipal  Contacto?    @relation("VisitaContactoPrincipal", fields: [contactoPrincipalId], references: [id], onDelete: SetNull)

  @@map("visitas")
}

// --- PROYECTOS (InLab) -----------------------------------------------

model Proyecto {
  id            String    @id @default(cuid())
  nombre        String
  hospitalId    String
  fechaInicio   DateTime
  fechaFin      DateTime?
  refConcurso   String?
  mapaHtml      String?   @db.Text
  mapaToken     String?   @unique
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  hospital     Hospital        @relation(fields: [hospitalId], references: [id])
  modulos      ProyectoModulo[]
  preProyectos PreProyecto[]   @relation("PreProyectoProyecto")

  @@map("proyectos")
}

model ProyectoModulo {
  proyectoId String
  moduloId   String
  estado     EstadoModulo @default(PENDIENTE)

  proyecto Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  modulo   ModuloInlab @relation(fields: [moduloId], references: [id])

  @@id([proyectoId, moduloId])
  @@map("proyectos_modulos")
}

model ModuloInlab {
  id        String           @id @default(cuid())
  nombre    String           @unique
  activo    Boolean          @default(true)
  proyectos ProyectoModulo[]

  @@map("modulos_inlab")
}

// --- CRM / PIPELINE --------------------------------------------------

model Oportunidad {
  id            String        @id @default(cuid())
  hospitalId    String
  usuarioId     String
  titulo        String
  etapa         EtapaPipeline @default(IDENTIFICADO)
  valorEstimado Float?
  probabilidad  Int?
  fechaCierre   DateTime?
  productos     Json          @default("[]")
  notas         String?
  motivoPerdida String?
  historial     Json          @default("[]")
  creadoEn      DateTime      @default(now())
  editadoEn     DateTime      @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])
  visitas  Visita[]

  @@map("oportunidades")
}

// --- PRE-PROYECTOS ---------------------------------------------------

model PreProyecto {
  id            String            @id @default(cuid())
  titulo        String
  descripcion   String?           @db.Text
  hospitalId    String
  responsableId String?
  proyectoId    String?
  estado        EstadoPreProyecto @default(NUEVO)
  prioridad     Int               @default(0)
  presupuesto   Float?
  fechaInicio   DateTime?
  fechaFinPlan  DateTime?
  fechaFinReal  DateTime?
  notas         String?           @db.Text
  mapaHtml      String?           @db.Text
  shareToken    String?           @unique
  creadoEn      DateTime          @default(now())
  editadoEn     DateTime          @updatedAt

  hospital         Hospital              @relation(fields: [hospitalId], references: [id])
  responsable      Usuario?              @relation("PreProyectoResponsable", fields: [responsableId], references: [id], onDelete: SetNull)
  proyecto         Proyecto?             @relation("PreProyectoProyecto", fields: [proyectoId], references: [id], onDelete: SetNull)
  fases            FasePreProyecto[]
  hitos            Hito[]
  solicitudes      SolicitudMaterial[]
  hardwareUnidades HardwareUnidad[]
  contactos        PreProyectoContacto[]
  visitas          Visita[]

  @@map("pre_proyectos")
}

model FasePreProyecto {
  id            String     @id @default(cuid())
  preProyectoId String
  tipo          TipoFase
  nombre        String
  orden         Int
  estado        EstadoFase @default(PENDIENTE)
  fechaPlan     DateTime?
  fechaReal     DateTime?
  responsableId String?
  notas         String?    @db.Text
  creadoEn      DateTime   @default(now())
  editadoEn     DateTime   @updatedAt

  preProyecto PreProyecto @relation(fields: [preProyectoId], references: [id], onDelete: Cascade)
  responsable Usuario?    @relation("FaseResponsable", fields: [responsableId], references: [id], onDelete: SetNull)

  @@map("fases_pre_proyectos")
}

model Hito {
  id            String   @id @default(cuid())
  preProyectoId String
  titulo        String
  descripcion   String?
  fecha         DateTime
  fechaReal     DateTime?
  completado    Boolean  @default(false)
  creadoEn      DateTime @default(now())
  editadoEn     DateTime @updatedAt

  preProyecto PreProyecto @relation(fields: [preProyectoId], references: [id], onDelete: Cascade)

  @@map("hitos")
}

model SolicitudMaterial {
  id               String          @id @default(cuid())
  preProyectoId    String
  titulo           String
  estado           EstadoSolicitud @default(PENDIENTE)
  fechaSolicitud   DateTime        @default(now())
  fechaEntregaPlan DateTime?
  fechaEntregaReal DateTime?
  notas            String?         @db.Text
  creadoEn         DateTime        @default(now())
  editadoEn        DateTime        @updatedAt

  preProyecto PreProyecto    @relation(fields: [preProyectoId], references: [id], onDelete: Cascade)
  lineas      LineaMaterial[]

  @@map("solicitudes_material")
}

model LineaMaterial {
  id                String @id @default(cuid())
  solicitudId       String
  nombre            String
  referencia        String?
  cantidad          Int
  cantidadEntregada Int    @default(0)
  unidad            String @default("ud")
  notas             String?

  solicitud SolicitudMaterial @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@map("lineas_material")
}

// --- HARDWARE --------------------------------------------------------

model HardwareCatalogo {
  id          String       @id @default(cuid())
  tipo        TipoHardware
  marca       String
  modelo      String
  descripcion String?
  precio      Float?
  fichaUrl    String?
  activo      Boolean      @default(true)
  creadoEn    DateTime     @default(now())
  editadoEn   DateTime     @updatedAt

  unidades HardwareUnidad[]

  @@map("hardware_catalogo")
}

model HardwareUnidad {
  id            String         @id @default(cuid())
  catalogoId    String
  numSerie      String?
  estado        EstadoHardware @default(DISPONIBLE)
  hospitalId    String?
  preProyectoId String?
  fechaCompra   DateTime?
  fechaGarantia DateTime?
  notas         String?
  creadoEn      DateTime       @default(now())
  editadoEn     DateTime       @updatedAt

  catalogo    HardwareCatalogo @relation(fields: [catalogoId], references: [id])
  hospital    Hospital?        @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  preProyecto PreProyecto?     @relation(fields: [preProyectoId], references: [id], onDelete: SetNull)

  @@map("hardware_unidades")
}

// --- PIVOT PRE-PROYECTOS <-> CONTACTOS -------------------------------

model PreProyectoContacto {
  preProyectoId String
  contactoId    String

  preProyecto PreProyecto @relation(fields: [preProyectoId], references: [id], onDelete: Cascade)
  contacto    Contacto    @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@id([preProyectoId, contactoId])
  @@map("pre_proyectos_contactos")
}

// --- PLANTILLAS DE VISITA --------------------------------------------

model PlantillaVisita {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  tipo        String   @default("PROYECTOS") // PROYECTOS | VENTAS
  datos       Json     @default("{}")
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now())
  editadoEn   DateTime @updatedAt

  @@map("plantillas_visita")
}
