{"nodes": [{"id": "graphify_skill_pipeline", "label": "graphify full extraction pipeline", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns any folder of code/docs/papers/images/video into a persistent, queryable knowledge graph with an honest EXTRACTED/INFERRED/AMBIGUOUS audit trail, community detection, and query/path/explain tools, so codebase questions can be answered from a scoped subgraph instead of raw grep/full-file reads."}, {"id": "graphify_skill_fast_path_query", "label": "graphify fast-path query (existing graph.json)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If graphify-out/graph.json already exists and the user asks a natural-language question, skip the full rebuild (Steps 1-5) and jump straight to `graphify query` \u2014 avoids re-detecting/re-extracting the whole corpus just to answer a question."}, {"id": "graphify_skill_step1_install", "label": "Step 1 - detect/install graphify Python interpreter", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finds graphify via uv tool dir, pipx, or active venv (in that order) before falling back to install, and caches the resolved interpreter path in graphify-out/.graphify_python so every later step reuses the same environment that actually has graphify installed."}, {"id": "graphify_skill_step2_detect", "label": "Step 2 - detect corpus files", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_skill_step3_extract", "label": "Step 3 - extract entities and relationships (AST + semantic)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splits extraction into deterministic free AST parsing (Part A, code files) run in parallel with paid LLM semantic extraction (Part B, docs/papers/images) to save 5-15s on large corpora; Gemini backend used if GEMINI_API_KEY/GOOGLE_API_KEY set, otherwise Claude Code subagents do the semantic pass and no other provider API key is ever read."}, {"id": "graphify_skill_step4_build_cluster", "label": "Step 4 - build graph, cluster, analyze, generate outputs", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_skill_step5_label_communities", "label": "Step 5 - label communities with plain-language names", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_skill_step6_obsidian_html", "label": "Step 6 - Obsidian vault (opt-in) + HTML graph export", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_skill_step9_manifest_cost", "label": "Step 9 - save manifest, update cost tracker, cleanup", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "graphify_skill_honesty_rules", "label": "graphify honesty rules", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor